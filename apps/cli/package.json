{
  "name": "@cachkey/cli",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "cachkey": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outfile dist/cachkey.js",
    "compile": "bun build src/index.ts --compile --outfile dist/cachkey",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cachkey/shared": "workspace:*"
  }
}
