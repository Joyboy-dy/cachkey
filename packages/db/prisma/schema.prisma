// Cachkey database schema.
// Better Auth models (users, sessions, accounts, verifications, rate limits, organizations)
// and Cachkey business models (projects).
// Field names follow Better Auth's defaults; table names are mapped to snake_case.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String          @id
  name             String
  email            String          @unique
  emailVerified    Boolean         @default(false) @map("email_verified")
  image            String?
  /// Seed of the DiceBear « Clay » avatar (see apps/web/src/lib/avatar.ts).
  avatarSeed       String?         @map("avatar_seed")
  /// Two-factor authentication (Better Auth twoFactor plugin): asked at email sign-in.
  twoFactorEnabled Boolean         @default(false) @map("two_factor_enabled")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  sessions         Session[]
  twoFactor        TwoFactor?
  accounts         Account[]
  memberships      Member[]
  invitations      Invitation[]
  projects         Project[]
  secretChanges    Secret[]
  secretVersions   SecretVersion[]
  projectAccess    ProjectAccess[] @relation("accessUser")
  accessGrants     ProjectAccess[] @relation("accessGrantedBy")
  auditEvents      AuditEvent[]
  serviceTokens    ServiceToken[]  @relation("serviceTokenCreatedBy")

  @@map("users")
}

model Session {
  id                   String   @id
  token                String   @unique
  expiresAt            DateTime @map("expires_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  /// Organisation currently selected in the interface (Better Auth organization plugin).
  activeOrganizationId String?  @map("active_organization_id")
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

/// Credential (email + password) and OAuth provider accounts linked to a user.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens: email verification, password reset, OAuth state.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

/// Authenticator app secret and backup codes of a user, both encrypted by Better Auth.
/// `verified` stays false until the first code from the app has been checked.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @unique @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until")

  @@map("two_factors")
}

/// Better Auth rate limiting, persisted in PostgreSQL (no Redis). One row per IP + route.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

/// Workspace shared by a team. Created by its owner; members join through invitations (phase 5).
model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now()) @map("created_at")
  members     Member[]
  invitations Invitation[]
  projects    Project[]

  auditEvents AuditEvent[]

  @@map("organizations")
}

/// Membership of a user in an organisation. Roles: owner, admin, member.
model Member {
  id             String       @id
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

/// Invitation to join an organisation (used from phase 5; required by the plugin schema).
model Invitation {
  id             String       @id
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  teamId         String?      @map("team_id")
  status         String       @default("pending")
  expiresAt      DateTime     @map("expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  inviterId      String       @map("inviter_id")
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

/// A project groups the environments and secrets of one application (secrets: phase 4).
model Project {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// URL identifier, unique inside the organisation.
  slug           String
  description    String?
  /// Project data key, encrypted with the instance master key (see apps/api/src/crypto.ts).
  encryptedKey   String?         @map("encrypted_key")
  environments   Environment[]
  bricks         Brick[]
  access         ProjectAccess[]
  serviceTokens  ServiceToken[]
  createdById    String?         @map("created_by_id")
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@map("projects")
}

model Environment {
  id        String         @id @default(cuid())
  projectId String         @map("project_id")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  /// URL identifier, unique inside the project; stable on rename.
  slug      String
  position  Int            @default(0)
  secrets   Secret[]
  tokens    ServiceToken[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([projectId, slug])
  @@map("environments")
}

/// Independent part of a project (front-end, API…) with its own variables in every
/// environment. Each project has one « main » brick (all variables of a project that does not
/// use bricks) and one hidden « shared » brick whose variables every brick inherits; the
/// others are « custom ». Environments, members and tokens stay at the project level.
model Brick {
  id        String         @id @default(cuid())
  projectId String         @map("project_id")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  /// URL / CLI identifier, unique inside the project; stable on rename. The shared brick
  /// is always `shared`.
  slug      String
  /// "main", "shared" or "custom".
  kind      String         @default("custom")
  position  Int            @default(0)
  secrets   Secret[]
  tokens    ServiceToken[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([projectId, slug])
  @@map("bricks")
}

/// A variable of an environment, in one brick. `value` is always encrypted with the project
/// data key.
model Secret {
  id            String          @id @default(cuid())
  environmentId String          @map("environment_id")
  environment   Environment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  brickId       String          @map("brick_id")
  brick         Brick           @relation(fields: [brickId], references: [id], onDelete: Cascade)
  key           String
  value         String
  version       Int             @default(1)
  updatedById   String?         @map("updated_by_id")
  updatedBy     User?           @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  versions      SecretVersion[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([environmentId, brickId, key])
  @@index([brickId])
  @@map("secrets")
}

/// Every value a variable has had, encrypted like `Secret.value`.
model SecretVersion {
  id          String   @id @default(cuid())
  secretId    String   @map("secret_id")
  secret      Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  version     Int
  value       String
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([secretId, version])
  @@map("secret_versions")
}

/// What a member (not owner/admin) may do in a project. No row: the project is invisible.
model ProjectAccess {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  user           User     @relation("accessUser", fields: [userId], references: [id], onDelete: Cascade)
  /// "read" (see and copy values) or "write" (also add, edit, delete, import).
  level          String
  /// Environments the access covers; empty means every environment, present and future.
  environmentIds String[] @map("environment_ids")
  grantedById    String?  @map("granted_by_id")
  grantedBy      User?    @relation("accessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_access")
}

/// Who read or changed what, and when. Names are copied so events survive deletions.
model AuditEvent {
  id              String       @id @default(cuid())
  organizationId  String       @map("organization_id")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId         String?      @map("actor_id")
  actor           User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName       String       @map("actor_name")
  action          String
  projectId       String?      @map("project_id")
  projectName     String?      @map("project_name")
  environmentName String?      @map("environment_name")
  /// Set for projects split into bricks.
  brickName       String?      @map("brick_name")
  /// Variable name, member email… depending on the action.
  target          String?
  metadata        Json?
  ip              String?
  userAgent       String?      @map("user_agent")
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([organizationId, projectId, createdAt])
  @@map("audit_events")
}

/// Read-only access to one environment of one brick (with the shared variables) for a server,
/// a script or the CLI. Only a hash of
/// the token is stored; the token itself is shown once, at creation.
model ServiceToken {
  id            String      @id @default(cuid())
  projectId     String      @map("project_id")
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentId String      @map("environment_id")
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  brickId       String      @map("brick_id")
  brick         Brick       @relation(fields: [brickId], references: [id], onDelete: Cascade)
  name          String
  /// SHA-256 of the token (hex). Tokens are random, so a fast hash is enough.
  tokenHash     String      @unique @map("token_hash")
  /// First characters of the token, to recognise it in the list.
  prefix        String
  expiresAt     DateTime?   @map("expires_at")
  lastUsedAt    DateTime?   @map("last_used_at")
  createdById   String?     @map("created_by_id")
  createdBy     User?       @relation("serviceTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([projectId])
  @@map("service_tokens")
}

/// Pending `cachkey login` requests (Better Auth device authorization).
model DeviceCode {
  id              String    @id
  deviceCode      String    @unique @map("device_code")
  userCode        String    @unique @map("user_code")
  userId          String?   @map("user_id")
  expiresAt       DateTime  @map("expires_at")
  status          String
  lastPolledAt    DateTime? @map("last_polled_at")
  pollingInterval Int?      @map("polling_interval")
  clientId        String?   @map("client_id")
  scope           String?

  @@map("device_codes")
}
