# ─────────────────────────────────────────────────────────────────────────────
# Cachkey — environment variables (local development)
# Copy this file to `.env.local` at the repository root:  cp .env.example .env.local
# Never commit `.env.local`. All values below are placeholders or local-only defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────────────────
# Public origin of the web app. Everything (including /api/*) is served from it:
# the web server proxies /api/* to the API. Also used as Better Auth's base URL
# and to build links in emails.
APP_URL=http://localhost:3000

# Port the Elysia API listens on, and the URL the web server uses to reach it.
API_PORT=3001
API_INTERNAL_URL=http://localhost:3001

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Matches docker-compose.dev.yml (host port 5433 to avoid clashing with a local Postgres).
DATABASE_URL=postgresql://cachkey:cachkey@localhost:5433/cachkey

# ── Better Auth ─────────────────────────────────────────────────────────────
# Secret used to sign sessions and tokens. At least 32 characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-of-32-chars-min

# ── Encryption of secrets ───────────────────────────────────────────────────
# Master key protecting every project's data key: exactly 32 random bytes, base64.
# Generate one with:  openssl rand -base64 32
# Keep it safe and never change it: without it, stored secrets cannot be decrypted.
ENCRYPTION_KEY=

# ── OAuth providers (optional) ──────────────────────────────────────────────
# A provider is enabled only when BOTH its client ID and secret are set.
# The sign-in buttons appear automatically.
#
# Google — https://console.cloud.google.com/apis/credentials
#   Create an "OAuth client ID" of type "Web application".
#   Authorized JavaScript origin:  http://localhost:3000
#   Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# GitHub — https://github.com/settings/developers → "New OAuth App"
#   Homepage URL:                  http://localhost:3000
#   Authorization callback URL:    http://localhost:3000/api/auth/callback/github
#   Enable "Email addresses: read-only" if you use a GitHub App instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Emails ──────────────────────────────────────────────────────────────────
# "smtp" (default, Mailpit in development) or "resend" (production).
EMAIL_PROVIDER=smtp
EMAIL_FROM="Cachkey <no-reply@cachkey.local>"

# SMTP — defaults target Mailpit from docker-compose.dev.yml.
# Inbox UI: http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Resend — required when EMAIL_PROVIDER=resend. https://resend.com/api-keys
# EMAIL_FROM must then use a domain verified in Resend.
RESEND_API_KEY=
