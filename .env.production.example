# ─────────────────────────────────────────────────────────────────────────────
# Cachkey — production environment (example)
# Copy to `.env.prod` on the server; it is never committed.
#
# Only secrets, environment-specific values and feature flags belong here.
# Non-sensitive defaults (ports, internal URLs, SMTP defaults…) will be provided
# by `compose.yaml` (roadmap phase 7). A value set here always overrides them.
# The full list of variables is documented in `.env.example`.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the instance (HTTPS enables secure cookies).
APP_URL=https://cachkey.example.com

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Master key encrypting all secrets (32 bytes, base64). Back it up: losing it makes
# stored secrets unreadable. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# PostgreSQL connection string.
DATABASE_URL=postgresql://cachkey:change-me@postgres:5432/cachkey

# Transactional emails: "resend" (recommended) or "smtp".
EMAIL_PROVIDER=resend
EMAIL_FROM="Cachkey <no-reply@cachkey.example.com>"
RESEND_API_KEY=

# Optional OAuth providers — enabled only when both values are set.
# Callback URLs: <APP_URL>/api/auth/callback/google and <APP_URL>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
