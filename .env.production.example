# ─────────────────────────────────────────────────────────────────────────────
# Cachkey — production environment (example)
# Copy to `.env.prod` on the server; it is never committed. Then:
#   docker compose -f deploy/compose.yaml --env-file .env.prod up -d
#
# Only secrets, environment-specific values and feature flags belong here.
# Non-sensitive defaults (ports, internal URLs…) are set in `deploy/compose.yaml`.
# The full list of variables is documented in `.env.example`.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the instance, as users type it (HTTPS enables secure cookies).
APP_URL=https://cachkey.example.com

# Image version to run: a release such as 1.0.0 (recommended), or latest.
CACHKEY_VERSION=latest
# Host port of the web app (bound to 127.0.0.1: put your TLS reverse proxy in front).
CACHKEY_PORT=3000

# Password of the bundled PostgreSQL. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Master key encrypting all secrets (32 bytes, base64). Back it up: losing it makes
# stored secrets unreadable. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Transactional emails: "resend" or "smtp".
EMAIL_PROVIDER=resend
EMAIL_FROM="Cachkey <no-reply@cachkey.example.com>"
RESEND_API_KEY=
# With EMAIL_PROVIDER=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Optional OAuth providers — enabled only when both values are set.
# Callback URLs: <APP_URL>/api/auth/callback/google and <APP_URL>/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
